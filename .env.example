# Copy this file to `.env.local` and fill in real values. `.env.local` is never committed to GitHub.
# Values starting with NEXT_PUBLIC_ are built INTO the public website — only put public IDs there, never secrets.

# Your live domain (used for canonical URLs, sitemap.xml and social sharing cards)
NEXT_PUBLIC_SITE_URL=https://www.ecotreelogics.com

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX  (leave empty to disable analytics)
NEXT_PUBLIC_GA4_ID=

# Google Search Console HTML-tag verification code (only the content="..." value). Leave empty if you verify by DNS.
NEXT_PUBLIC_GSC_VERIFICATION=

# Where enquiry forms are sent.
#   php       -> /api/contact.php on your Hostinger account (default, needs PHP hosting)
#   web3forms -> https://web3forms.com (use if your plan has no PHP). Then also set NEXT_PUBLIC_WEB3FORMS_KEY.
NEXT_PUBLIC_FORM_PROVIDER=php
NEXT_PUBLIC_WEB3FORMS_KEY=

# Sub-folder the site is served from. Leave EMPTY for Hostinger and local use.
# GitHub Pages sets this automatically (e.g. /ecotree-logics) — you never need to fill it in by hand.
NEXT_PUBLIC_BASE_PATH=
